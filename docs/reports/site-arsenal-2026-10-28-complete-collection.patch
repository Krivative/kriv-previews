+.contactTitle h2 { font-size:clamp(3rem,5.3vw,6rem); max-width:15ch; }.contactTitle > p { max-width:45ch; }.contactTitle > a { display:inline-block; padding:14px 0; margin-top:18px; }
+.contactFacts { display:grid; grid-template-columns:1fr 1fr; gap:30px; font-size:.9rem; align-content:start; }.contactFacts h3 { font:500 .65rem/1.6 var(--font-body); text-transform:uppercase; letter-spacing:.13em; margin-bottom:13px; }.contactFacts dl { margin:0; }.contactFacts dl > div { margin-bottom:10px; }.contactFacts dd { margin:0; }.previewNote { grid-column:1 / -1; font-size:.72rem; color:var(--muted); max-width:60ch; }
