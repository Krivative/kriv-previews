+.offeringIndex a > span:first-child { font-size:.65rem; color:var(--muted); }
+.offerings,.story,.notes,.questions,.gallery,.contact { margin-inline:5vw; padding-block:75px; border-top:1px solid var(--line); }
+.sectionTitle { max-width:650px; margin-bottom:42px; }
+.sectionTitle > p:last-child:not(.eyebrow) { max-width:56ch; color:var(--muted); font-size:.95rem; line-height:1.9; }
