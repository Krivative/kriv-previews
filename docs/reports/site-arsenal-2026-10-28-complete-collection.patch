+
+/* 01 Clear / ATRIUM — spacious threshold, low image and two calm service leaves. */
+.atrium .navigation { display:grid; grid-template-columns:1fr auto 1fr; }.atrium .identity { grid-column:2; text-align:center; }.atrium .desktopNav { grid-column:1 / -1; justify-content:center; border-top:1px solid var(--line); padding-top:12px; }
+.atriumHero { padding-top:55px; }.atriumHeading { max-width:1000px; margin:auto; text-align:center; }.atriumHeading h1 { font-size:clamp(3.5rem,6.6vw,7rem); max-width:18ch; margin:20px auto 45px; }
+.atriumThreshold { display:grid; grid-template-columns:.2fr 1.2fr .6fr; gap:35px; align-items:end; }.atriumThreshold > .location { writing-mode:vertical-rl; transform:rotate(180deg); justify-self:start; }.atriumThreshold .scene { height:360px; }.atriumThreshold .scenePhoto { border-radius:140px 140px 0 0; }.atriumThreshold .introduction { padding-bottom:30px; }
+.panels .offeringList { grid-template-columns:1fr 1fr; gap:25px; }.panels .offering { border:1px solid var(--line); border-radius:4px 70px 4px 4px; padding:20px 30px; }.panels .offering summary { grid-template-columns:25px 1fr 20px; }.panels .offeringBody { padding:0 0 25px 47px; }
+
+/* 02 Bright / SIGNAL — a solid message block and full-height photographic counterweight. */
+.signal .navigation { border-bottom:0; }.signal .identity { font-family:var(--font-body); font-weight:700; }.signalHero { display:grid; grid-template-columns:1.1fr .9fr; padding:0; margin:0 3vw 70px; }
+.signalMessage { background:var(--accent); color:var(--accent-ink); padding:65px 5vw; }.signalMessage h1 { font-size:clamp(3.2rem,5.7vw,6rem); }.signalMessage .actions a { border-color:currentColor; }.signalMessage .actions a:first-child { background:var(--accent-ink); color:var(--accent); }
+.signalVisual { position:relative; display:flex; }.signalVisual .scene { width:100%; min-height:640px; }.signalLabel { position:absolute; bottom:0; left:0; right:0; display:flex; align-items:center; gap:30px; padding:25px 30px; background:var(--bg); }.signalLabel > span { font-size:3rem; line-height:1; color:var(--accent); }
+.matrix .offeringList { grid-template-columns:repeat(2,1fr); gap:2px; background:var(--line); border:1px solid var(--line); }.matrix .offering { background:var(--bg); border:0; padding:30px; }.matrix .offering summary { grid-template-columns:1fr 25px; align-items:start; }.matrix .number { grid-column:1 / -1; font-size:3.2rem; color:var(--accent); }.matrix .offeringBody { padding:0 0 20px; }
+
+/* 03 Gloss / NOCTURNE — a narrow portrait interrupted by oversized fashion typography. */
+.nocturne .navigation { margin-inline:4vw; border-bottom:0; }.nocturne .desktopNav { display:none; }.nocturne .menu { display:block; }.nocturne .identity { letter-spacing:.12em; text-transform:uppercase; font-size:1rem; }
+.nocturneHero { display:grid; grid-template-columns:60px 1fr 42%; grid-template-rows:auto auto; gap:45px; padding:35px 0 100px; position:relative; }
+.nocturneSpine { grid-column:1; grid-row:1 / 3; display:flex; justify-content:space-between; flex-direction:column; padding-block:35px; border-right:1px solid var(--line); }.nocturneSpine .eyebrow { writing-mode:vertical-rl; }.nocturneSpine .location { writing-mode:vertical-rl; transform:rotate(180deg); }
+.nocturneTitle { grid-column:2 / 4; grid-row:1; align-self:center; z-index:2; pointer-events:none; }.nocturneTitle h1 { font-size:clamp(4rem,8.4vw,9rem); max-width:13ch; text-shadow:0 2px 22px #0009; }
+.nocturneHero > .scene { grid-column:3; grid-row:1 / 3; height:680px; }.nocturneHero > .scene::after { content:""; position:absolute; inset:0 0 25px; background:linear-gradient(90deg,#141214aa,transparent 80%); pointer-events:none; }.nocturneHero > .introduction { grid-column:2; grid-row:2; align-self:end; z-index:2; }
+.curtains .offeringList { grid-template-columns:1fr 1fr; gap:60px; }.curtains .offering { border-top:1px solid var(--accent); border-bottom:0; padding-top:30px; }.curtains .offering summary { grid-template-columns:20px 1fr 20px; min-height:150px; }.curtains h3 { font-size:clamp(2.5rem,3.6vw,4rem); }.curtains .offeringBody { padding-left:42px; }
+
+/* 04 Poster / PRESS — a typographic front page with three editorial columns. */
+.press .navigation { border-block:1px solid var(--ink); margin-top:20px; padding:14px 0; }.press .identity { font:500 .85rem var(--font-body); text-transform:uppercase; }.pressHero { padding-top:30px; }
+.pressDateline { display:flex; justify-content:space-between; gap:25px; }.pressHero > h1 { font-size:clamp(4rem,9vw,10rem); text-transform:uppercase; letter-spacing:-.02em; max-width:22ch; border-bottom:5px solid var(--accent); padding-bottom:35px; }
+.pressColumns { display:grid; grid-template-columns:.65fr 1.25fr .7fr; gap:35px; }.pressColumns > .introduction { border-right:1px solid var(--line); padding-right:25px; }.pressColumns .scene { min-height:330px; }.pressColumns > .offeringIndex { border:0; padding:0; align-self:start; }
+.classifieds .offeringList { grid-template-columns:repeat(3,1fr); border-block:2px solid var(--ink); }.classifieds .offering { padding:20px 25px; border:0; border-right:1px solid var(--line); }.classifieds .offering summary { grid-template-columns:1fr 20px; }.classifieds .number { grid-column:1 / -1; }.classifieds h3 { text-transform:uppercase; font-size:2rem; }.classifieds .offeringBody { padding:0 0 20px; }
+
+/* 05 Bean / ROASTERY — an oval image and a quiet letter on a warm paper field. */
