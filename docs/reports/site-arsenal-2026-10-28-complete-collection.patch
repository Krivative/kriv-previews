+.scene figcaption { padding-top:12px; font-size:.64rem; line-height:1.6; color:var(--muted); }
+.emptyScene { flex:1; min-height:220px; background:repeating-linear-gradient(135deg,transparent,transparent 39px,var(--line) 40px,transparent 41px),var(--surface); border:1px solid var(--line); }
+.offeringIndex { padding:24px; border:1px solid var(--line); align-self:end; }
