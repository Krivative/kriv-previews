+.letter .storyTitle { max-width:850px; }.letter .storyCopy { max-width:none; }.letter .storyCopy > p::first-letter { float:left; font:4rem/.9 var(--font-display); margin:8px 10px 0 0; }
+.aside { grid-template-columns:.6fr 1.4fr; }.aside .storyTitle h2 { font-size:2.5rem; }.aside .storyCopy > p { font:clamp(1.6rem,2.4vw,2.5rem)/1.5 var(--font-display); }
+.manifesto { grid-template-columns:1.4fr .6fr; align-items:center; }.manifesto h2 { font-size:clamp(3rem,5vw,6rem); }.manifesto .storyCopy { border-top:3px solid var(--accent); padding-top:28px; }
+.notes { display:grid; grid-template-columns:.8fr 1.2fr; gap:25px 65px; padding-block:40px; }
+.notes h2 { font:500 .8rem/1.8 var(--font-body); letter-spacing:.13em; text-transform:uppercase; margin:0; }
+.notes > p { grid-column:2; font-size:.9rem; line-height:1.9; }
+.noteList { grid-column:2; }.noteList details { border-top:1px solid var(--line); }
+.noteList summary { display:flex; align-items:center; gap:18px; min-height:54px; padding:14px 0; font-size:.9rem; }.noteList summary > span:first-child { font-size:.65rem; color:var(--muted); }.noteList summary > span:last-child { margin-left:auto; }
+.noteList details > p { padding:4px 20px 22px 35px; font-size:.9rem; line-height:1.8; }
+.questions { display:grid; grid-template-columns:.75fr 1.25fr; gap:70px; }.questions details { border-bottom:1px solid var(--line); }.questions summary { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:18px 0; min-height:64px; }.questions details p { padding:4px 20px 24px 0; color:var(--muted); line-height:1.9; }
+.gallery h2 { margin-bottom:40px; }
