@@ -0,0 +1,56 @@
+// Synthetic local sample checks only; never targets a real business or Lead Desk.
+import { createRequire } from "node:module";
+import { readFileSync, readdirSync, mkdirSync } from "node:fs";
+import { delimiter } from "node:path";
+import assert from "node:assert/strict";
+import { sitePages } from "../src/lib/site-pages.ts";
+import { SiteData } from "../src/lib/site-schema.ts";
+const require = createRequire(import.meta.url);
+const { chromium } = require(require.resolve("playwright", { paths: [process.cwd(), ...(process.env.NODE_PATH ?? "").split(delimiter)] }));
+const base = process.env.BASE_URL ?? "http://localhost:3101";
+assert(["localhost", "127.0.0.1"].includes(new URL(base).hostname));
+mkdirSync("shots/pages", { recursive: true });
+const sites = readdirSync("src/sites").filter((f) => /^sample-.*\.json$/.test(f)).map((f) => SiteData.parse(JSON.parse(readFileSync(`src/sites/${f}`, "utf8"))));
+const selected = [...new Map(sites.map((site) => [site.template.split("-")[0], site])).values()];
+const browser = await chromium.launch();
+let captures = 0;
+try {
+  for (const site of selected) {
+    for (const [label, width] of [["desktop", 1440], ["phone", 390]]) {
+      const page = await browser.newPage({ viewport: { width, height: 900 } });
+      await page.emulateMedia({ reducedMotion: "reduce" });
+      const errors = [];
+      page.on("pageerror", (e) => errors.push(String(e)));
+      page.on("console", (m) => { if (m.type() === "error") errors.push(m.text()); });
+      const response = await page.goto(`${base}/${site.slug}`, { waitUntil: "networkidle" });
+      assert.equal(response.status(), 200);
+      if (width === 390) await page.locator("header details > summary").click();
