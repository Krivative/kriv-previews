diff --git a/scripts/verify-pages.mjs b/scripts/verify-pages.mjs
new file mode 100644
index 0000000..8d13da5
--- /dev/null
+++ b/scripts/verify-pages.mjs
@@ -0,0 +1,32 @@
+// Verify every known sample page against a running local production build.
+// BASE_URL=http://localhost:3101 node scripts/verify-pages.mjs
+import { readFileSync, readdirSync } from "node:fs";
+import { SiteData } from "../src/lib/site-schema.ts";
+import { sitePages, pageHref } from "../src/lib/site-pages.ts";
+
+const base = process.env.BASE_URL ?? "http://localhost:3101";
+if (!["localhost", "127.0.0.1"].includes(new URL(base).hostname)) throw new Error("Run this verifier against a local server.");
+let total = 0;
+for (const file of readdirSync("src/sites").filter((f) => /^sample-.*\.json$/.test(f))) {
+  const site = SiteData.parse(JSON.parse(readFileSync(`src/sites/${file}`, "utf8")));
+  const pages = sitePages(site);
+  const known = new Set(pages.map((p) => pageHref(site, p.path)));
+  await Promise.all(pages.map(async (page) => {
+    const res = await fetch(`${base}${pageHref(site, page.path)}`);
+    const body = await res.text();
+    if (res.status !== 200 || res.headers.get("x-robots-tag") !== "noindex, nofollow" || !body.includes('name="robots" content="noindex, nofollow"') || !body.includes("Concept preview prepared by KRIV")) throw new Error(`Guardrail failure: ${site.slug}/${page.path}`);
+    if (/<form\b|<input\b|href="(?:tel:|mailto:)/.test(body)) throw new Error(`Active action: ${site.slug}/${page.path}`);
+    for (const [, href] of body.matchAll(/<a\b[^>]*href="([^"]*)"/g)) {
+      if (!href.startsWith("#") && !href.startsWith("https://unsplash.com/") && !known.has(href)) throw new Error(`Unexpected destination: ${href}`);
+    }
+    total++;
+  }));
+}
+for (const route of ["/not-a-sample/contact", "/sample-hvac-calm/not-a-page", "/sample-cafe-calm/services/not-an-item", "/__proto__/about"]) {
+  const res = await fetch(base + route);
+  const body = await res.text();
+  // The existing Cache Components source gallery can stream its not-found view
+  // with 200. Previews have stricter status tests in their own smoke suite.
+  if (![200, 404].includes(res.status) || !body.includes("No site here") || body.includes("Concept preview prepared by KRIV")) throw new Error(`${route}: did not render the anonymous not-found view`);
+}
+console.log(`PASS: ${total} sample pages; 4 anonymous not-found views; noindex, banner and inert actions. Source gallery retains its existing streamed-404 status limitation.`);
