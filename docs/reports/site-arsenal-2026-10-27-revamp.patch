@@ -0,0 +1,25 @@
+import type { Metadata } from "next";
+import { notFound } from "next/navigation";
+import { allSites, getSite } from "@/lib/sites";
+import { sitePages } from "@/lib/site-pages";
+import { SiteRenderer } from "@/sections/SiteRenderer";
+
+export function generateStaticParams() {
+  return allSites().flatMap(({ site }) => sitePages(site).filter((p) => p.path).map((p) => ({ slug: site.slug, path: p.path.split("/") })));
+}
+
+export async function generateMetadata({ params }: PageProps<"/[slug]/[...path]">): Promise<Metadata> {
+  const { slug, path } = await params;
+  const found = getSite(slug);
+  const page = found && sitePages(found.site).find((p) => p.path === path.join("/"));
+  return found && page ? { title: `${page.title} | ${found.site.business.name}`, description: found.site.seo.description, robots: { index: false, follow: false } } : {};
+}
+
+export default async function SiteSubpage({ params }: PageProps<"/[slug]/[...path]">) {
+  const { slug, path } = await params;
+  const found = getSite(slug);
+  if (!found) notFound();
+  const page = sitePages(found.site).find((p) => p.path === path.join("/"));
+  if (!page) notFound();
+  return <SiteRenderer site={found.site} template={found.template} page={page} />;
+}
